generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Business models are added incrementally from the approved domain documents.

model ParentAccount {
  id              String          @id @default(cuid())
  familySlot      String          @unique @default("primary-family")
  email           String          @unique
  passwordHash String
  sessions        ParentSession[]
  learner         LearnerProfile?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model LearnerProfile {
  id         String        @id @default(cuid())
  parent     ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String        @unique
  nickname   String
  avatarId   String
  pinHash    String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ParentSession {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  parent      ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String
  mode        SessionMode   @default(PARENT)
  expiresAt   DateTime
  lastSeenAt  DateTime      @default(now())
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([parentId])
  @@index([expiresAt])
}

enum SessionMode {
  PARENT
  LEARNER
}
