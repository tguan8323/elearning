generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Business models are added incrementally from the approved domain documents.

model ParentAccount {
  id              String          @id @default(cuid())
  familySlot      String          @unique @default("primary-family")
  email           String          @unique
  passwordHash String
  sessions        ParentSession[]
  learner         LearnerProfile?
  adaptation      FamilyAdaptation?
  deletionIntents LearnerDeletionIntent[]
  deletionTombstones LearnerDeletionTombstone[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model LearnerProfile {
  id         String        @id @default(cuid())
  parent     ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId   String        @unique
  nickname   String
  avatarId   String
  pinHash    String
  sessions   TeachingSession[]
  observations LearningObservation[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ParentSession {
  id          String        @id @default(cuid())
  tokenHash   String        @unique
  parent      ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String
  mode        SessionMode   @default(PARENT)
  expiresAt   DateTime
  lastSeenAt  DateTime      @default(now())
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([parentId])
  @@index([expiresAt])
}

enum SessionMode {
  PARENT
  LEARNER
}

model FamilyAdaptation {
  id                 String        @id @default(cuid())
  parent             ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId           String        @unique
  sessionMinutes     Int           @default(15)
  sessionsPerWeek    Int           @default(5)
  accent             String        @default("en-US")
  reducedMotion      Boolean       @default(true)
  soundEnabled       Boolean       @default(true)
  interests          String[]
  excludedThemes     String[]
  availableMaterials String[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model LearnerDeletionIntent {
  id          String        @id @default(cuid())
  parent      ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String
  learnerId   String
  tokenHash   String        @unique
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  @@index([parentId, learnerId])
}

model LearnerDeletionTombstone {
  id                      String        @id @default(cuid())
  parent                  ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId                String
  deletedLearnerId        String
  teachingSessionCount    Int
  observationCount        Int
  deletedAt               DateTime      @default(now())

  @@index([parentId, deletedAt])
}

model TeachingSession {
  id           String         @id @default(cuid())
  clientId     String         @unique
  learner      LearnerProfile @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId    String
  targetId     String
  targetTitle  String
  status       String         @default("PLANNED")
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime       @default(now())
  observations LearningObservation[]

  @@index([learnerId, createdAt])
}

model LearningObservation {
  id            String          @id @default(cuid())
  clientId      String          @unique
  learner       LearnerProfile  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learnerId     String
  session       TeachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  targetId      String
  outcome       String
  promptLevel   String?
  materialVariant String?
  note          String?
  observedAt    DateTime        @default(now())

  @@index([learnerId, targetId, observedAt])
}
